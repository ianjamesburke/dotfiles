#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Subscription usage for Claude, Codex, Antigravity. `--json` for machine output."""
import argparse
import json
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
# Below this fraction of the window elapsed, used/elapsed is dominated by noise
# (12% used 5% into a 7d window reads as 250%), so no projection is shown.
MIN_ELAPSED = 0.15


class ProviderError(Exception):
    pass


def window(label: str, used_pct: float, resets: datetime, window_h: float, now: datetime | None = None) -> dict:
    left_h = max((resets - (now or datetime.now(timezone.utc))).total_seconds() / 3600, 0)
    elapsed = 1 - left_h / window_h
    w = {
        "label": label,
        "used_pct": used_pct,
        "resets_at": resets.astimezone(timezone.utc).isoformat(),
        "hours_left": round(left_h, 2),
        "window_hours": window_h,
        "elapsed_pct": round(elapsed * 100, 1),
        "projected_pct": None,
        "over_pace": None,
        "budget_pct_per_hour": None,
    }
    if elapsed >= MIN_ELAPSED:
        w["projected_pct"] = round(used_pct / elapsed, 1)
        w["over_pace"] = w["projected_pct"] > 100
        w["budget_pct_per_hour"] = round((100 - used_pct) / left_h, 2) if left_h else None
    return w


def claude() -> list[dict]:
    try:
        raw = subprocess.run(
            ["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
            capture_output=True, text=True, check=True,
        ).stdout
        token = json.loads(raw)["claudeAiOauth"]["accessToken"]
        req = urllib.request.Request(
            "https://api.anthropic.com/api/oauth/usage",
            headers={"Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20"},
        )
        data = json.load(urllib.request.urlopen(req, timeout=15))
    except (subprocess.CalledProcessError, KeyError, urllib.error.URLError, json.JSONDecodeError) as e:
        raise ProviderError(f"usage fetch (keychain 'Claude Code-credentials' -> api.anthropic.com/api/oauth/usage): {e}. Run `claude` once to refresh login.") from e
    return [
        window(label, data[key]["utilization"], datetime.fromisoformat(data[key]["resets_at"]), 5 if "five" in key else 168)
        for key, label in [("five_hour", "5-hour"), ("seven_day", "7-day"), ("seven_day_opus", "7d Opus"), ("seven_day_sonnet", "7d Sonnet")]
        if data.get(key) and data[key].get("resets_at")
    ]


def codex() -> list[dict]:
    try:
        proc = subprocess.Popen(["codex", "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    except OSError as e:
        raise ProviderError(f"start `codex app-server`: {e}") from e
    try:
        def call(msg: dict) -> None:
            proc.stdin.write(json.dumps(msg) + "\n")
            proc.stdin.flush()

        call({"id": 1, "method": "initialize", "params": {"clientInfo": {"name": "ai-usage", "version": "0"}}})
        call({"method": "initialized"})
        call({"id": 2, "method": "account/rateLimits/read"})
        for line in proc.stdout:
            msg = json.loads(line)
            if msg.get("id") == 2:
                break
        else:
            raise ProviderError("`codex app-server` exited before answering account/rateLimits/read")
    except (OSError, json.JSONDecodeError) as e:
        raise ProviderError(f"`codex app-server` account/rateLimits/read: {e}") from e
    finally:
        proc.kill()
    if "error" in msg:
        raise ProviderError(f"account/rateLimits/read: {msg['error']}. Run `codex login`.")
    res = msg["result"]
    out = []
    for key in ("primary", "secondary"):
        w = res["rateLimits"].get(key)
        if w:
            mins = w["windowDurationMins"]
            label = f"{mins // 1440}-day" if mins >= 1440 else f"{mins // 60}-hour"
            out.append(window(label, w["usedPercent"], datetime.fromtimestamp(w["resetsAt"], timezone.utc), mins / 60))
    credits = res.get("rateLimitResetCredits", {}).get("credits", [])
    avail = [c for c in credits if c["status"] == "available"]
    if out and avail:
        exp = min(datetime.fromtimestamp(c["expiresAt"]) for c in avail)
        out[0]["note"] = f"{len(avail)} free full rate-limit reset available, expires {exp:%a %Y-%m-%d}"
    return out


def antigravity() -> list[dict]:
    try:
        out = subprocess.run(["agy", "-p", "/quota"], capture_output=True, text=True, check=True, timeout=60).stdout
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as e:
        raise ProviderError(f"`agy -p /quota`: {e}. Run `agy` interactively to log in.") from e
    windows = []
    for line in out.splitlines():
        try:
            bucket, win, remaining, reset = line.split("\t")
        except ValueError as e:
            raise ProviderError(f"unparseable /quota line: {line!r}") from e
        if remaining == "disabled":
            continue
        five = win.startswith("Five")
        windows.append(window(
            f"{bucket.split()[0]} {'5h' if five else '7d'}",
            100 - float(remaining.rstrip("%")),
            datetime.fromisoformat(reset.replace("Z", "+00:00")),
            5 if five else 168,
        ))
    return windows


def left(hours: float) -> str:
    m = int(hours * 60)
    if m <= 0:
        return "now"
    d, r = divmod(m, 1440)
    h = r // 60
    return f"{d}d {h}h" if d else f"{h}h" if h else f"{m}m"


def render(results: dict, short: bool) -> None:
    red, dim, reset = ("\033[31m", "\033[2m", "\033[0m") if sys.stdout.isatty() else ("", "", "")
    rows = [("", "WINDOW", "USED", "RESETS", "LEFT", "PACE", "BUDGET/DAY")]
    errors = []
    for name, result in results.items():
        if "error" in result:
            errors.append(f"{name}: {result['error']}")
            continue
        for w in result["windows"]:
            if w["window_hours"] <= 24 and not short:
                continue
            when = datetime.fromisoformat(w["resets_at"]).astimezone().strftime("%a %H:%M")
            if w["projected_pct"] is None:
                pace, budget = "-", "-"
            else:
                pace = f"{w['projected_pct']:.0f}% " + ("OVER" if w["over_pace"] else "ok")
                budget = f"{w['budget_pct_per_hour'] * 24:.1f}%" if w["window_hours"] > 24 else "-"
            rows.append((name, w["label"], f"{w['used_pct']:.0f}%", when, left(w["hours_left"]), pace, budget))
    widths = [max(len(r[i]) for r in rows) for i in range(7)]
    prev = None
    for i, r in enumerate(rows):
        cells = [c.ljust(widths[j]) if j in (0, 1, 3, 5) else c.rjust(widths[j]) for j, c in enumerate(r)]
        if i and r[0] == prev:
            cells[0] = " " * widths[0]
        prev = r[0]
        line = "  ".join(cells)
        print(f"{dim}{line}{reset}" if i == 0 else f"{red}{line}{reset}" if r[5].endswith("OVER") else line)
    notes = {n: r["windows"][0]["note"] for n, r in results.items() if r.get("windows") and "note" in r["windows"][0]}
    for n, note in notes.items():
        print(f"{dim}{n}: {note}{reset}")
    for e in errors:
        print(f"FAILED {e}")


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--json", action="store_true", help="emit JSON instead of text")
    ap.add_argument("--short", action="store_true", help="also show windows of 24h or less (5-hour rows)")
    args = ap.parse_args()
    results = {}
    for name, fn in (("claude", claude), ("codex", codex), ("antigravity", antigravity)):
        try:
            results[name] = {"windows": fn()}
        except ProviderError as e:
            results[name] = {"error": str(e)}
    if args.json:
        print(json.dumps({"generated_at": datetime.now(timezone.utc).isoformat(), "providers": results}, indent=2))
        return
    render(results, args.short)


if __name__ == "__main__":
    main()
