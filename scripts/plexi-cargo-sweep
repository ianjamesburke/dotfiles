#!/bin/bash
# Default is a preview. launchd supplies --apply; a busy build takes priority.
set -euo pipefail
REPO="$HOME/Documents/GitHub/PLEXI"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$HOME/.cargo/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# Never inherit a stale nesting marker from the caller. A busy build gets priority.
unset PLEXI_CARGO_LOCK_HELD PLEXI_CARGO_LOCK
export PLEXI_CARGO_LEASE_TIMEOUT_SECS=1
exec /bin/bash "$REPO/scripts/cargo-with-lease.sh" node "$SCRIPT_DIR/plexi-prune.mjs" "$@"
