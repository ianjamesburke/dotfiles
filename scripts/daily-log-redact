#!/usr/bin/env python3
"""Redact secrets from files git is about to commit. Usage: daily-log-redact <repo>

Detection is gitleaks (rules + entropy), not hand-rolled regex. Each detected
secret is replaced in place with [REDACTED:<rule-id>]. Exits nonzero if gitleaks
is missing or fails, so the caller never commits an unscanned file.
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


def pending_files(repo: Path) -> list[Path]:
    out = subprocess.run(
        ["git", "-C", str(repo), "ls-files", "-m", "-o", "--exclude-standard", "-z"],
        check=True, capture_output=True,
    ).stdout
    return [repo / p.decode() for p in out.split(b"\0") if p]


def findings(path: Path) -> list[dict]:
    with tempfile.NamedTemporaryFile(suffix=".json") as report:
        subprocess.run(
            ["gitleaks", "dir", str(path), "--no-banner", "--exit-code=0",
             "-l", "error", "-f", "json", "-r", report.name],
            check=True, capture_output=True,
        )
        raw = Path(report.name).read_text()
        return json.loads(raw) if raw.strip() else []


def main() -> None:
    if len(sys.argv) != 2:
        sys.exit("usage: daily-log-redact <repo>")
    if shutil.which("gitleaks") is None:
        sys.exit("daily-log-redact: gitleaks not on PATH (brew install gitleaks); refusing to commit unscanned files")
    repo = Path(sys.argv[1])
    for path in pending_files(repo):
        if not path.is_file():
            continue
        try:
            found = findings(path)
        except (subprocess.CalledProcessError, json.JSONDecodeError) as e:
            sys.exit(f"daily-log-redact: gitleaks failed on {path}: {e}")
        if not found:
            continue
        text = path.read_text(encoding="utf-8", errors="surrogateescape")
        for f in sorted(found, key=lambda f: -len(f["Secret"])):
            text = text.replace(f["Secret"], f"[REDACTED:{f['RuleID']}]")
        tmp = path.with_name(path.name + ".redact.tmp")
        tmp.write_text(text, encoding="utf-8", errors="surrogateescape")
        os.replace(tmp, path)
        print(f"redacted {len(found)} secret(s) in {path.relative_to(repo)}", file=sys.stderr)


if __name__ == "__main__":
    main()
